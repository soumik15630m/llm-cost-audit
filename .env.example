# ─────────────────────────────────────────────────────────────────────────────
# Contact form delivery (app/api/contact/route.ts) — Resend.
# Add these in Vercel → Project → Settings → Environment Variables, then redeploy.
# On each submission the Edge Function sends TWO emails:
#   • to the lead  — personalized next steps + a link to your Slack
#   • to you       — a "they just joined" notification with their details
# With RESEND_API_KEY unset, submissions still succeed and are written to the
# function logs (never silently lost).
# ─────────────────────────────────────────────────────────────────────────────

# Required — Resend API key (https://resend.com, free tier).
RESEND_API_KEY=

# Required — where YOUR "new lead joined" notification is sent ("to me").
CONTACT_TO_EMAIL=

# Recommended — verified sender, e.g. "LLM Cost Audit <hello@yourdomain.com>".
# IMPORTANT: to email *leads* (external addresses), this domain must be verified
# in Resend. If unset it falls back to onboarding@resend.dev, which only delivers
# to your own account address — enough for the notification, not the lead reply.
# CONTACT_FROM_EMAIL="LLM Cost Audit <hello@yourdomain.com>"

# Optional — Slack invite/channel link for follow-ups, included in both emails.
# SLACK_INVITE_URL=https://join.slack.com/t/your-workspace/shared_invite/...

# Optional — return an error if neither email delivered (default: succeed + log).
# STRICT_CONTACT=1

# ─────────────────────────────────────────────────────────────────────────────
# Consent log (Neon Postgres). Each submission records name, email, company,
# spend, consent=true, time, IP, and user agent to a `consent_log` table (auto-
# created on first write). Paste your Neon connection string. If unset, consent
# logging is skipped and the form still works.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=

